# Копия-шаблон конфигурации.
# Скопируйте в .env и заполните реальными значениями:
#   copy .env.example .env   (Windows)
#   cp .env.example .env     (Linux/macOS)
#
# ВНИМАНИЕ: файл .env содержит реальные секреты и НЕ должен попадать в git (.env добавлен в .gitignore).

# Режим БД: "sqlite" (разработка) или "postgres" (продакшен)
DATABASE_MODE=sqlite

# --- PostgreSQL (используется при DATABASE_MODE=postgres) ---
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change_me
DB_NAME=task_manager